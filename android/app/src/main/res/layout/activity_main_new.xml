<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <!-- ========================
         Top Section: Status Bar
         ======================== -->

    <!-- Settings Button (Top Right) -->
    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="@string/cd_settings"
        android:src="@android:drawable/ic_menu_manage"
        app:tint="@color/text_secondary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- App Logo/Title (Top Left) -->
    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:text="@string/app_name"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Status Indicator -->
    <LinearLayout
        android:id="@+id/statusContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/tvAppTitle"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/statusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/circle_status_online" />

        <TextView
            android:id="@+id/tvStatusTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/status_online"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp" />

    </LinearLayout>


    <!-- ========================
         Center Section: Fluid Gradient Visualizer
         ======================== -->

    <FrameLayout
        android:id="@+id/visualizerContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/statusContainer"
        app:layout_constraintBottom_toTopOf="@id/promptText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Main Visualizer Circle -->
        <View
            android:id="@+id/fluidGradientView"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:background="@drawable/circle_idle" />

    </FrameLayout>

    <!-- Prompt Text -->
    <TextView
        android:id="@+id/promptText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="请对我说..."
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:fontFamily="sans-serif-light"
        app:layout_constraintBottom_toTopOf="@id/tvState"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- State Text -->
    <TextView
        android:id="@+id/tvState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/state_idle"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.05"
        app:layout_constraintBottom_toTopOf="@id/transcriptCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


    <!-- ========================
         Transcript Section
         ======================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/transcriptCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/surface_elevated"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toTopOf="@id/buttonContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Transcript Label -->
            <TextView
                android:id="@+id/tvTranscriptLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="你说"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1" />

            <!-- Transcript Text -->
            <TextView
                android:id="@+id/tvTranscript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:maxLines="3"
                android:ellipsize="end"
                tools:text="播放周杰伦的音乐" />

            <!-- Response Text (hidden by default) -->
            <View
                android:id="@+id/responseDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/surface_elevated"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvResponseLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="我"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/secondary"
                android:textSize="15sp"
                android:maxLines="3"
                android:ellipsize="end"
                android:visibility="gone"
                tools:text="正在为你播放周杰伦的七里香" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ========================
         Bottom Section: Action Buttons
         ======================== -->

    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="32dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Main Voice Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTrigger"
            style="@style/Widget.VoiceAssistant.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="@string/btn_hold_to_speak"
            android:textSize="16sp"
            app:icon="@android:drawable/ic_btn_speak_now"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:cornerRadius="30dp" />

        <!-- Interrupt Button (hidden in IDLE state) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInterrupt"
            style="@style/Widget.VoiceAssistant.Button.Secondary"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="16dp"
            android:visibility="gone"
            app:icon="@android:drawable/ic_media_pause"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:cornerRadius="30dp"
            app:strokeWidth="2dp"
            android:contentDescription="打断" />

    </LinearLayout>


    <!-- ========================
         Secondary Action Buttons
         ======================== -->

    <LinearLayout
        android:id="@+id/secondaryButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@id/buttonContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHistory"
            style="@style/Widget.VoiceAssistant.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="历史"
            android:textSize="13sp"
            app:icon="@android:drawable/ic_menu_recent_history"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            app:iconPadding="6dp" />

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginHorizontal="24dp"
            android:background="@color/text_tertiary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuickActions"
            style="@style/Widget.VoiceAssistant.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="快捷指令"
            android:textSize="13sp"
            app:icon="@android:drawable/ic_menu_add"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            app:iconPadding="6dp" />

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginHorizontal="24dp"
            android:background="@color/text_tertiary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHelp"
            style="@style/Widget.VoiceAssistant.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="帮助"
            android:textSize="13sp"
            app:icon="@android:drawable/ic_menu_help"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            app:iconPadding="6dp" />

    </LinearLayout>


    <!-- ========================
         Memory Warning Card (hidden by default)
         ======================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/memoryWarningCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/error"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/statusContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_dialog_alert"
                app:tint="@color/white"
                android:contentDescription="警告" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/warning_memory_low"
                android:textColor="@color/white"
                android:textSize="13sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
{
  "version": "1.0.0",
  "models": {
    "kws": {
      "name": "KWS 唤醒词模型",
      "version": "2025-02-28",
      "type": "kws",
      "files": {
        "model": "model.onnx",
        "tokens": "tokens.txt",
        "keywords": "keywords.txt"
      },
      "config": {
        "numThreads": 1,
        "provider": "cpu",
        "sampleRate": 16000,
        "decodingMethod": "greedy_search"
      }
    },
    "asr": {
      "name": "ASR 语音识别模型 (Paraformer)",
      "version": "v1.12.30",

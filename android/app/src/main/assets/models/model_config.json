      "files": {
        "model": "model.onnx",
        "decodeit": "decodeit.nemo",
        "vocab": "vocab.txt"
      },
      "config": {
        "numThreads": 4,
        "provider": "cpu",
        "sampleRate": 16000,
        "decodingMethod": "greedy_search"
      }
    },
    "tts": {
      "name": "TTS 语音合成模型 (花燕)",
      "version": "2025-01-15",
